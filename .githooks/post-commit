#!/usr/bin/env bash
# Builds HEAD (not the working tree) to the live binary path, then re-runs
# `install` from that live copy so trigger changes ship too. Skips install
# when sudo can't prompt, rather than failing the commit.
fail() {
    echo "post-commit: $1 — the installed binary is now behind HEAD" >&2
    exit 0
}

# Git exports the main index to hooks; left set, `worktree add` writes into it.
unset GIT_INDEX_FILE

tree=$(mktemp -d)
trap 'git worktree remove --force "$tree" 2>/dev/null; rm -rf "$tree"' EXIT
git worktree add -q --detach "$tree" HEAD || fail "worktree failed"

(cd "$tree" && go build -ldflags "-s -w -X main.version=$(git describe --tags --always)-dev" \
    -o "$OLDPWD/bits-wifi-login" ./cmd/bits-wifi-login) || fail "rebuild failed"

# Absent = never installed here.
live=$(readlink -f "$(command -v bits-wifi-login)" 2>/dev/null) || exit 0
[ -n "$live" ] && [ "$live" != "$PWD/bits-wifi-login" ] || exit 0

# Copy beside, then rename: overwriting a running binary is "text file busy".
cp bits-wifi-login "$live.new" && mv -f "$live.new" "$live" || fail "install to $live failed"
echo "post-commit: installed $("$live" version) to $live"

if [ -t 2 ] || sudo -n true 2>/dev/null; then
    "$live" install || fail "install failed"
else
    echo "post-commit: no terminal for sudo, skipped install — run: $live install" >&2
fi
